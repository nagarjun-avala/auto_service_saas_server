# Server Environment Variables
#
# The server loads .env.{NODE_ENV} automatically:
#   - .env.development  (default when NODE_ENV is not set)
#   - .env.production
#
# Copy this file to .env.development and fill in the values to get started.

# Node environment (development, production, test)
NODE_ENV=development

# Server port
PORT=5000

# Frontend URL (for email verification and password reset links)
CLIENT_URL=http://localhost:5173

# Database Connection
DATABASE_URL=

# JWT Configuration
# Separate secrets for tenant and system-admin authentication.
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET="your-long-random-secret"
JWT_REFRESH_SECRET="your-different-long-random-secret"

JWT_ACCESS_EXPIRES_IN="0m"
JWT_REFRESH_EXPIRES_IN="0d"