// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  SERVICE_ADVISOR
  TECHNICIAN
  CASHIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  LPG
  ELECTRIC
  HYBRID
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  AMT
  CVT
  DCT
  OTHER
}

enum JobCardStatus {
  DRAFT
  RECEIVED
  INSPECTION
  ESTIMATE_PENDING
  CUSTOMER_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_FOR_PARTS
  QUALITY_CHECK
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum ServiceType {
  GENERAL_SERVICE
  PERIODIC_SERVICE
  OIL_CHANGE
  BRAKE_SERVICE
  AC_SERVICE
  ENGINE_REPAIR
  ELECTRICAL
  SUSPENSION
  TYRE_SERVICE
  BATTERY
  BODY_WORK
  DIAGNOSTIC
  OTHER
}

enum InspectionStatus {
  GOOD
  ATTENTION
  URGENT
  NOT_CHECKED
  NOT_APPLICABLE
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum ItemType {
  PART
  LABOUR
  OTHER
}

enum StockMovementType {
  PURCHASE
  JOB_USAGE
  RETURN
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

enum ReminderType {
  DATE_BASED
  ODOMETER_BASED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  ESTIMATE_PENDING
  VEHICLE_READY
  PAYMENT_DUE
  SERVICE_REMINDER
  GENERAL
}

enum InspectionItemStatus {
  PASS
  ATTENTION
  FAIL
  NOT_CHECKED
}

enum InspectionType {
  GENERAL
  SERVICE
  REPAIR
  PRE_PURCHASE
  INSURANCE
}

enum EstimateItemType {
  LABOUR
  PART
  OTHER
}

enum PartType {
  OEM
  AFTERMARKET
  USED
  OTHER
}

enum StockTransactionType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  JOB_CARD_USAGE
  RETURN
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

enum JobCardItemType {
  LABOUR
  PART
  OTHER
}

enum InvoiceItemType {
  LABOUR
  PART
  OTHER
}

// ============================================================
// WORKSHOP / TENANT
// ============================================================

model Workshop {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String
  slug String @unique

  phone   String?
  email   String?
  address String?
  gstin   String?

  logoUrl String?

  currency String @default("INR")
  timezone String @default("Asia/Kolkata")

  invoicePrefix String @default("INV")
  jobCardPrefix String @default("JC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  branches          Branch[]
  customers         Customer[]
  vehicles          Vehicle[]
  jobCards          JobCard[]
  inspections       Inspection[]
  estimates         Estimate[]
  inventoryItems    InventoryItem[]
  categories        InventoryCategory[]
  suppliers         Supplier[]
  invoices          Invoice[]
  payments          Payment[]
  reminders         ServiceReminder[]
  notifications     Notification[]
  parts             Part[]
  stockTransactions StockTransaction[]
  purchases         Purchase[]

  @@index([name])
}

// ============================================================
// BRANCH
// ============================================================
// Included now so Stage 2 multi-branch expansion doesn't require
// redesigning the tenant structure.

model Branch {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId

  name     String
  code     String
  phone    String?
  email    String?
  address  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop       Workshop        @relation(fields: [workshopId], references: [id])
  users          User[]
  jobCards       JobCard[]
  inventoryItems InventoryItem[]
  suppliers      Supplier[]
  invoices       Invoice[]
  payments       Payment[]

  @@unique([workshopId, code])
  @@index([workshopId])
}

// ============================================================
// USERS / AUTH
// ============================================================

model User {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String  @db.ObjectId
  branchId   String? @db.ObjectId

  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  password  String

  role   UserRole   @default(SERVICE_ADVISOR)
  status UserStatus @default(ACTIVE)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  createdJobCards      JobCard[]              @relation("JobCardCreatedBy")
  advisorJobCards      JobCard[]              @relation("JobCardAdvisor")
  technicianJobCards   JobCard[]              @relation("JobCardTechnician")
  statusChanges        JobCardStatusHistory[]
  inspectionsCompleted Inspection[]
  refreshTokens        RefreshToken[]
  stockTransactions    StockTransaction[]
  purchases            Purchase[]
  payments             Payment[]

  @@index([workshopId])
  @@index([branchId])
  @@index([phone])
}

model RefreshToken {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  tokenHash String

  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId

  firstName      String
  lastName       String
  phone          String
  email          String?
  alternatePhone String?
  address        String?
  notes          String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  vehicles  Vehicle[]
  jobCards  JobCard[]
  estimates Estimate[]
  invoices  Invoice[]
  payments  Payment[]
  reminders ServiceReminder[]

  @@unique([workshopId, phone])
  @@index([workshopId])
  @@index([phone])
  @@index([firstName])
  @@index([lastName])
  @@index([isActive])
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId
  customerId String @db.ObjectId

  registrationNumber String
  make               String
  model              String
  variant            String?

  year Int?

  fuelType     FuelType?
  transmission TransmissionType?

  vin           String?
  chassisNumber String?
  engineNumber  String?
  color         String?

  currentOdometer Int @default(0)

  insuranceExpiry DateTime?
  pucExpiry       DateTime?
  warrantyExpiry  DateTime?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  jobCards  JobCard[]
  reminders ServiceReminder[]

  @@unique([workshopId, registrationNumber])
  @@index([workshopId])
  @@index([customerId])
  @@index([registrationNumber])
  @@index([make])
  @@index([model])
  @@index([isActive])
}

// ============================================================
// JOB CARD
// ============================================================

model JobCard {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId
  branchId   String @db.ObjectId

  customerId String @db.ObjectId
  vehicleId  String @db.ObjectId

  advisorId    String? @db.ObjectId
  technicianId String? @db.ObjectId
  createdById  String  @db.ObjectId

  jobNumber String

  status      JobCardStatus @default(DRAFT)
  serviceType ServiceType?

  odometerIn  Int?
  odometerOut Int?

  fuelLevel Int?

  customerComplaint String
  internalNotes     String?

  promisedDate DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  customer Customer @relation(fields: [customerId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  advisor    User? @relation("JobCardAdvisor", fields: [advisorId], references: [id])
  technician User? @relation("JobCardTechnician", fields: [technicianId], references: [id])
  createdBy  User  @relation("JobCardCreatedBy", fields: [createdById], references: [id])

  statusHistory JobCardStatusHistory[]
  inspection    Inspection?
  estimate      Estimate?

  labourItems LabourItem[]
  partsUsed   JobPart[]

  invoice      Invoice?
  jobCardItems JobCardItem[]

  @@unique([workshopId, jobNumber])
  @@index([workshopId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([technicianId])
  @@index([status])
  @@index([createdAt])
}

model SequenceCounter {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId

  key   String
  value Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workshopId, key])
  @@index([workshopId])
}

// ============================================================
// JOB CARD STATUS HISTORY
// ============================================================

model JobCardStatusHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  jobCardId   String @db.ObjectId
  changedById String @db.ObjectId

  fromStatus JobCardStatus?
  toStatus   JobCardStatus

  note String?

  createdAt DateTime @default(now())

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  changedBy User @relation(fields: [changedById], references: [id])

  @@index([jobCardId])
  @@index([changedById])
  @@index([createdAt])
  @@index([toStatus])
}

// ============================================================
// INSPECTION
// ============================================================

model Inspection {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId
  jobCardId  String @db.ObjectId

  type InspectionType @default(GENERAL)

  technicianId String? @db.ObjectId

  overallNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  technician User? @relation(fields: [technicianId], references: [id])

  items InspectionItem[]

  @@unique([jobCardId])
  @@index([workshopId])
  @@index([technicianId])
}

// ============================================================
// INSPECTION ITEMS
// ============================================================

model InspectionItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  inspectionId String @db.ObjectId

  category String
  itemName String

  status InspectionItemStatus @default(NOT_CHECKED)

  observation    String?
  recommendation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id])

  @@index([inspectionId])
  @@index([status])
}

// ============================================================
// ESTIMATE
// ============================================================

model Estimate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId
  jobCardId  String @db.ObjectId

  estimateNumber String
  status         EstimateStatus @default(DRAFT)

  subtotal   Int @default(0)
  discount   Int @default(0)
  taxAmount  Int @default(0)
  grandTotal Int @default(0)

  notes String?

  sentAt     DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])
  jobCard  JobCard  @relation(fields: [jobCardId], references: [id])

  items      EstimateItem[]
  customer   Customer?      @relation(fields: [customerId], references: [id])
  customerId String?        @db.ObjectId

  @@unique([workshopId, estimateNumber])
  @@unique([jobCardId])
  @@index([workshopId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// ESTIMATE ITEMS
// ============================================================

model EstimateItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  estimateId String @db.ObjectId

  type        EstimateItemType
  description String

  quantity  Int @default(1)
  unitPrice Int @default(0)
  discount  Int @default(0)
  taxRate   Int @default(0)
  total     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id])

  @@index([estimateId])
  @@index([type])
}

// ============================================================
// LABOUR ITEMS
// ============================================================

model LabourItem {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  jobCardId String @db.ObjectId

  technicianId String? @db.ObjectId

  description String

  hours  Float @default(1)
  rate   Float @default(0)
  amount Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCard JobCard @relation(fields: [jobCardId], references: [id])

  @@index([jobCardId])
  @@index([technicianId])
}

model Part {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId

  partNumber String
  name       String

  description String?

  type PartType @default(OEM)

  brand String?

  category String?

  unit String @default("PCS")

  purchasePrice Int @default(0)
  sellingPrice  Int @default(0)

  taxRate Int @default(0)

  minStock Int  @default(0)
  maxStock Int?

  currentStock Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  stockTransactions StockTransaction[]
  purchaseItems     PurchaseItem[]
  jobCardItems      JobCardItem[]
  invoiceItems      InvoiceItem[]

  @@unique([workshopId, partNumber])
  @@index([workshopId])
  @@index([name])
  @@index([category])
  @@index([brand])
  @@index([isActive])
}

model StockTransaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId
  partId     String @db.ObjectId

  type StockTransactionType

  quantity Int

  unitCost Int?

  referenceId String?

  notes String?

  createdById String @db.ObjectId

  createdAt DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id])

  part Part @relation(fields: [partId], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([workshopId])
  @@index([partId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// INVENTORY CATEGORY
// ============================================================

model InventoryCategory {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  items InventoryItem[]

  @@unique([workshopId, name])
  @@index([workshopId])
}

// ============================================================
// INVENTORY ITEM
// ============================================================

model InventoryItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String  @db.ObjectId
  branchId   String? @db.ObjectId
  categoryId String? @db.ObjectId

  name String
  sku  String

  brand String?
  unit  String  @default("PCS")

  costPrice    Float @default(0)
  sellingPrice Float @default(0)

  currentStock Float @default(0)
  minimumStock Float @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop           @relation(fields: [workshopId], references: [id])
  branch   Branch?            @relation(fields: [branchId], references: [id])
  category InventoryCategory? @relation(fields: [categoryId], references: [id])

  stockMovements StockMovement[]
  jobParts       JobPart[]
  invoiceItems   InvoiceItem[]
  // estimateItems EstimateItem[]

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([branchId])
  @@index([categoryId])
  @@index([name])
  @@index([sku])
}

// ============================================================
// JOB PARTS / PARTS USED
// ============================================================

model JobPart {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  jobCardId       String @db.ObjectId
  inventoryItemId String @db.ObjectId

  quantity Float @default(1)

  unitCost  Float @default(0)
  unitPrice Float @default(0)
  amount    Float @default(0)

  createdAt DateTime @default(now())

  jobCard       JobCard       @relation(fields: [jobCardId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([jobCardId])
  @@index([inventoryItemId])
}

// ============================================================
// STOCK MOVEMENT
// ============================================================

model StockMovement {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  inventoryItemId String @db.ObjectId

  type StockMovementType

  quantity Float

  unitCost      Float?
  referenceType String?
  referenceId   String?

  note String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

// ============================================================
// SUPPLIER
// ============================================================

model Supplier {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId

  name String

  contactPerson String?

  phone String?
  email String?

  address String?

  gstNumber String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  // purchases Purchase[]
  branch    Branch?    @relation(fields: [branchId], references: [id])
  branchId  String?    @db.ObjectId
  purchases Purchase[]

  @@index([workshopId])
  @@index([name])
  @@index([phone])
  @@index([gstNumber])
  @@index([isActive])
}

model Purchase {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workshopId String @db.ObjectId
  supplierId String @db.ObjectId

  purchaseNumber String

  status PurchaseStatus @default(RECEIVED)

  invoiceNumber String?
  invoiceDate   DateTime?

  subtotal   Int @default(0)
  discount   Int @default(0)
  taxAmount  Int @default(0)
  grandTotal Int @default(0)

  notes String?

  receivedAt DateTime @default(now())

  createdById String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  items PurchaseItem[]

  @@unique([workshopId, purchaseNumber])
  @@index([workshopId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  purchaseId String @db.ObjectId
  partId     String @db.ObjectId

  quantity Int

  unitCost Int

  discount Int @default(0)
  taxRate  Int @default(0)

  taxAmount Int @default(0)
  total     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  part Part @relation(fields: [partId], references: [id])

  @@index([purchaseId])
  @@index([partId])
}

model JobCardItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  jobCardId String  @db.ObjectId
  partId    String? @db.ObjectId

  type        JobCardItemType
  description String

  quantity         Int @default(1)
  consumedQuantity Int @default(0)

  unitPrice Int @default(0)
  discount  Int @default(0)
  taxRate   Int @default(0)
  taxAmount Int @default(0)
  total     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCard JobCard @relation(fields: [jobCardId], references: [id])
  part    Part?   @relation(fields: [partId], references: [id])

  @@index([jobCardId])
  @@index([partId])
  @@index([type])
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  workshopId    String        @db.ObjectId
  jobCardId     String        @db.ObjectId
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  subtotal   Int @default(0)
  discount   Int @default(0)
  taxAmount  Int @default(0)
  grandTotal Int @default(0)

  issuedAt    DateTime?
  cancelledAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop   Workshop      @relation(fields: [workshopId], references: [id])
  jobCard    JobCard       @relation(fields: [jobCardId], references: [id])
  items      InvoiceItem[]
  payments   Payment[]
  branch     Branch?       @relation(fields: [branchId], references: [id])
  branchId   String?       @db.ObjectId
  customer   Customer?     @relation(fields: [customerId], references: [id])
  customerId String?       @db.ObjectId

  @@unique([workshopId, invoiceNumber])
  @@unique([jobCardId])
  @@index([workshopId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// INVOICE ITEMS
// ============================================================

model InvoiceItem {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String @db.ObjectId

  type   InvoiceItemType
  partId String?         @db.ObjectId

  description String
  quantity    Int    @default(1)
  unitPrice   Int    @default(0)
  discount    Int    @default(0)
  taxRate     Int    @default(0)
  taxAmount   Int    @default(0)
  total       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice         Invoice        @relation(fields: [invoiceId], references: [id])
  part            Part?          @relation(fields: [partId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String?        @db.ObjectId

  @@index([invoiceId])
  @@index([partId])
  @@index([type])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId
  invoiceId  String @db.ObjectId

  amount Int
  method PaymentMethod

  referenceNumber String?
  notes           String?

  receivedById String @db.ObjectId

  createdAt DateTime @default(now())

  workshop   Workshop  @relation(fields: [workshopId], references: [id])
  invoice    Invoice   @relation(fields: [invoiceId], references: [id])
  receivedBy User      @relation(fields: [receivedById], references: [id])
  branch     Branch?   @relation(fields: [branchId], references: [id])
  branchId   String?   @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?   @db.ObjectId

  @@index([workshopId])
  @@index([invoiceId])
  @@index([method])
  @@index([createdAt])
}

// ============================================================
// SERVICE REMINDER
// ============================================================

model ServiceReminder {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId

  customerId String @db.ObjectId
  vehicleId  String @db.ObjectId

  type   ReminderType
  status ReminderStatus @default(PENDING)

  dueDate     DateTime?
  dueOdometer Int?

  title String
  notes String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([workshopId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  workshopId String @db.ObjectId

  type NotificationType

  title   String
  message String

  entityType String?
  entityId   String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id])

  @@index([workshopId])
  @@index([isRead])
  @@index([createdAt])
}
