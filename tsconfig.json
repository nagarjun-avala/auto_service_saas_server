{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    // "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "#config/*": [
        "./src/config/*"
      ],
      "#generated/*": [
        "./src/generated/*"
      ],
      "#controllers/*": [
        "./src/controllers/*"
      ],
      "#middlewares/*": [
        "./src/middlewares/*"
      ],
      "#modules/*": [
        "./src/modules/*"
      ],
      "#routes/*": [
        "./src/routes/*"
      ],
      "#services/*": [
        "./src/services/*"
      ],
      "#types/*": [
        "./src/types/*"
      ],
      "#utils/*": [
        "./src/utils/*"
      ]
    },
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}